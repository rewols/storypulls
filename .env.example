# --- Required ---
ANTHROPIC_API_KEY=

# --- Google Maps (optional but recommended) ---
# Server key with "Places API (New)" enabled. Without it, places are listed but not verified.
GOOGLE_MAPS_API_KEY=
# Browser key with "Maps JavaScript API" enabled; restrict it to your site's HTTP referrer.
GOOGLE_MAPS_BROWSER_KEY=
# Map ID for advanced markers (Google Cloud console > Map Management). DEMO_MAP_ID works for testing.
GOOGLE_MAP_ID=DEMO_MAP_ID

# --- Access ---
# Shared password for you and friends. Leave empty to disable (only do that on localhost).
APP_PASSWORD=

# --- Platform cookies (Netscape cookies.txt, exported from a logged-in browser) ---
# With docker compose, drop the files in ./cookies and use /cookies/<name>.txt.
COOKIES_INSTAGRAM=
COOKIES_XIAOHONGSHU=
COOKIES_TIKTOK=

# --- Tuning ---
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# tiny | base | small | medium | large-v3. "small" is a good CPU trade-off and handles Mandarin.
WHISPER_MODEL=small
MAX_FRAMES=12
MAX_VIDEO_SECONDS=600

# For running `npm run dev` outside docker:
WORKER_URL=http://localhost:8000
